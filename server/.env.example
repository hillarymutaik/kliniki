# Copy to .env and fill in. Never commit the real file.

# --- Database -----------------------------------------------------------------------------------
# The API connects as kliniki_app: an unprivileged role that cannot bypass row-level security.
DATABASE_URL=postgres://kliniki_app:CHANGE-ME@localhost:5432/kliniki
# Used only by `npm run migrate`. The role that owns the schema; never give this to the API.
DATABASE_OWNER_URL=postgres://postgres:CHANGE-ME@localhost:5432/kliniki
# Name of the role the API connects as. Optional; defaults to kliniki_app.
# APP_DB_ROLE=kliniki_app
# Migrations create that role with this password (and reset it on every run).
# Leave unset if your DBA creates the role themselves.
APP_DB_PASSWORD=CHANGE-ME
DB_POOL_MAX=20
# How long a request waits for a free database connection before it gets HTTP 503.
DB_CONNECT_TIMEOUT_MS=5000
# How long a write waits for its clinic's lock before the device is told to retry (HTTP 503).
DB_LOCK_TIMEOUT_MS=5000

# --- Security -----------------------------------------------------------------------------------
# Signs access tokens. At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start without it. Changing it signs everyone out.
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
# Long on purpose: a tablet that was offline for a day must still be able to refresh and sync.
REFRESH_TOKEN_TTL_DAYS=30
# If set, creating a clinic needs this code (signup by invitation). Strongly recommended until you
# have a public signup flow.
REGISTRATION_CODE=
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_MINUTE=10
# Comma-separated browser origins allowed to call the API (the web app). Empty = none.
CORS_ORIGINS=
# Set to true only behind a reverse proxy you control, so rate limits see real client addresses.
TRUST_PROXY=false

# --- Runtime ------------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
